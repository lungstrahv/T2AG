#!/bin/bash
# t2ag 启动脚本（可选辅助）
# 位置：main/bin/t2ag
# 作用：进入 t2ag 目录，展示欢迎语、欢迎图与版本号
# 注意：t2ag 的核心启动方式是在 AI 对话中发送「t2ag」或「读取 t2ag.md」
# 欢迎信息与版本号定义详见 t2ag.md「启动欢迎信息」章节

set -e

T2AG_DIR="/c/Users/MikeChen/T2AC/t2ag"
SKIN_DIR="$T2AG_DIR/main/skin"
SKIN_YAML="$SKIN_DIR/skin.yaml"

# 版本号需与 t2ag.md 顶部「当前版本」保持一致
T2AG_VERSION="0.1.2"

cd "$T2AG_DIR" || { echo "无法进入 $T2AG_DIR"; exit 1; }

# 欢迎语
echo ""
echo "欢迎使用，因懒惰而生的 vibe learning，agent t2ag。"
echo "当前目录：$(pwd)"
echo ""

# 读 skin.yaml 获取 active 皮肤（简化版，实际由 agent 读取）
if [ -f "$SKIN_YAML" ]; then
    ACTIVE=$(grep '^active:' "$SKIN_YAML" | head -1 | sed 's/active: *//')
    if [ -n "$ACTIVE" ]; then
        SKIN_FOLDER=$(grep "^registry.$ACTIVE:" "$SKIN_YAML" | head -1 | sed "s/registry.$ACTIVE: *//")
        if [ -n "$SKIN_FOLDER" ] && [ -f "$SKIN_DIR/$SKIN_FOLDER/skin.yaml" ]; then
            ART_FILE=$(grep '^art_file:' "$SKIN_DIR/$SKIN_FOLDER/skin.yaml" | head -1 | sed 's/art_file: *//')
            if [ -n "$ART_FILE" ] && [ -f "$SKIN_DIR/$SKIN_FOLDER/$ART_FILE" ]; then
                echo '```'
                cat "$SKIN_DIR/$SKIN_FOLDER/$ART_FILE"
                echo '```'
                echo ""
            fi
        fi
    fi
fi

# 版本号
echo "version: $T2AG_VERSION"
echo ""
