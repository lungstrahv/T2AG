{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:t2ag:schema:t2ag.external_reference.v1",
  "title": "T2AG external repository reference sidecar V1 (tier-1 reference contract)",
  "description": "Lightweight one-way read-only reference contract. Tier-1 of the two-tier cross-repo standard: use this for frozen-version or living-data references into an external repo; use a full saga bridge (reading_bridge_v1 style) only for bidirectional exchange. Absolute host paths may appear ONLY in peer_root_hints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner_id", "owner_path", "bound_at", "peer_root_hints", "references"],
  "properties": {
    "schema": {"type": "string", "const": "t2ag.external_reference.v1"},
    "owner_id": {"type": "string", "pattern": "(EG|AR|U)-[0-9]{4}[a-z]?|[A-Z][A-Z0-9]{1,15}"},
    "owner_path": {"type": "string", "format": "posix-relative-path", "maxLength": 512},
    "bound_at": {"type": "string", "format": "date-time"},
    "peer_root_hints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["windows_host"],
        "properties": {
          "windows_host": {"type": "string", "minLength": 1, "maxLength": 512},
          "resolution_note": {"type": "string", "maxLength": 500}
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference_id", "peer_system", "peer_relative_path", "kind", "integrity_mode"],
        "properties": {
          "reference_id": {"type": "string", "pattern": "[a-z0-9_.]{1,64}"},
          "peer_system": {"type": "string", "pattern": "[a-z0-9-]{1,32}"},
          "peer_relative_path": {"type": "string", "format": "posix-relative-path", "maxLength": 512},
          "kind": {"type": "string", "enum": ["frozen_version", "living_data"]},
          "peer_version": {"type": "string", "maxLength": 32},
          "effective_date": {"type": "string", "format": "date"},
          "integrity_mode": {"type": "string", "enum": ["pinned", "existence_only"]},
          "content_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
          "usage_rule": {"type": "string", "enum": ["read_only", "copy_on_use"]},
          "rebind": {"type": "string", "enum": ["manual_only"]},
          "note": {"type": "string", "maxLength": 500}
        }
      }
    }
  },
  "$comment": "kind=frozen_version requires integrity_mode=pinned + content_sha256 + peer_version; kind=living_data requires integrity_mode=existence_only + usage_rule=copy_on_use. Doctor enforces these conditional rules (JSON Schema kept flat for readability). peer_relative_path is POSIX relative inside the peer repo; no drive letters, no backslashes, no '..'."
}
