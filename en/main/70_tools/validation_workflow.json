      "phase": "runtime",
      "handler": "check_canonical_teaching_carrier",
      "depends_on": [
        "runtime.course_discovery"
      ]
    }
  },
  "profiles": {
    "runtime": {
      "default": true,
      "explicit_only": false,
      "extends": null,
      "checks": [
        "runtime.structure",
        "runtime.skeleton_privacy",
        "runtime.version_profile",
        "runtime.version_bump_precondition",
        "runtime.skin",
        "runtime.authorization",
        "runtime.course_discovery",
        "runtime.groups",
        "runtime.activity_ledgers",
        "runtime.engagements_activities",
        "runtime.question_banks",
        "runtime.knowledge_ledgers",
        "runtime.exam_banks",
        "runtime.project_verification",
        "runtime.exercises",
        "runtime.teacher_contract",
        "runtime.memory_pointers",
        "runtime.registry",
        "runtime.textbook_preparation",
        "runtime.canonical_teaching_carrier",
        "runtime.scope_page_cache",
        "runtime.checkpoint_block_routing",
        "runtime.gate_ledger",
        "runtime.recommendation_ledger",
        "runtime.gate_visibility",
        "runtime.problemlog_closure",
        "runtime.external_source_backlink",
        "runtime.rule_enforcement_integrity",
        "runtime.playbook_taxonomy",
        "runtime.playbook_usage",
        "runtime.domain_tier_reconciliation",
        "runtime.trading_boundary",
        "runtime.external_references",
        "runtime.legacy_references",
        "runtime.retired_instance_ids",
        "runtime.cloud_pause",
        "runtime.context_packet",
        "runtime.test_management",
        "runtime.decision_records",
        "runtime.decision_record_citations",
        "runtime.course_templates",
        "runtime.environment",
        "runtime.changelog",
        "runtime.memory_budget",
        "runtime.constitution_budget",
        "runtime.line_endings"
      ]
    },
    "release": {
      "default": false,
      "explicit_only": true,
      "extends": "runtime",
      "checks": [
        "release.flow_guide",
        "release.handoff",
        "release.cloud",
        "release.derived_tools",
        "release.reading_bridge",
        "release.core_playbooks",
        "release.playbook_taxonomy_parity",
        "release.candidate_replay",
        "release.tracked_environment",
        "release.dirty_tree",
        "release.skeleton_textbook",
        "release.package_surface",
        "release.candidate_binding",
        "release.distribution_parity",
        "release.constitution_parity",
        "release.cross_edition_parity",
        "release.line_endings"
      ]
    }
  },
  "validation_levels": {
    "V0": {
      "doctor_profile": null,
      "max_test_tier": null,
      "description": "changed files only"
    },
    "V1": {
      "doctor_profile": "runtime",
      "max_test_tier": "fast",
      "description": "direct local regression"
    },
    "V2": {
      "doctor_profile": "runtime",
      "max_test_tier": "deep",
      "description": "affected contracts and distribution parity"
    },
    "V3": {
      "doctor_profile": "release",
      "max_test_tier": "release_only",
      "description": "real migration or frozen release candidate"
    }
  },
  "guards": {
    "default_profile": "runtime",
    "release_explicit_only": true,
    "release_plan_binding_required": true,
    "release_suite_plan_only": true,
    "no_implicit_tier_escalation": true
  },
  "release_execution_reasons": [
    "formal_release",
    "version_upgrade",
    "full_review",
    "real_migration",
    "release_candidate"
  ],
  "ordinary_budget": {
    "max_agents": 1,
    "max_test_commands": 3,
    "max_minutes": 10,
    "excluded_paths": [
      ".venv/",
      "t2ag-lite/",
      "recovery/",
      "staging/",
      "main/40_course/*/book/",
      "images/"
    ]
  }
}
