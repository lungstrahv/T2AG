{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t2ag.answers.v2",
  "title": "T2AG 首次启动可选资料",
  "description": "五项用户资料全部可选；省略时由 t2ag_init.py 使用公开默认值。语言在安装阶段选择，不进入 answers.json。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "example_only": {"type": "boolean", "description": "示例拒绝标记；true 时工具不得消费。"},
    "nickname": {"type": "string", "default": "同学", "description": "希望被怎样称呼。"},
    "learning_level": {
      "enum": ["not_provided", "secondary_school", "university", "bachelor"],
      "default": "not_provided",
      "description": "学习水平：尚未提供（未自述时的缺省态，呈现为「尚未提供」）、中学在读、大学在读、学士。学生事实无默认档位，省略不等于中学在读。"
    },
    "reference_curriculum": {
      "enum": ["yes", "no", "pending_generation"],
      "default": "pending_generation",
      "description": "是否引入参考培养方案；未回答为有待生成。"
    },
    "learning_interests": {"type": "string", "default": "有待生成", "description": "学习兴趣，自由文本。"},
    "self_introduction": {"type": "string", "default": "未提供", "description": "可选自我介绍。"},
    "tutoring_preference": {"type": "string", "default": "先给整体地图，再逐支展开；每步结束后确认再继续", "description": "高级可选覆盖；首启不主动询问。"},
    "long_explanation_mode": {"enum": ["map-first", "continuous", "user-defined"], "default": "map-first", "description": "高级可选覆盖。"},
    "lesson_tree_display_mode": {"enum": ["progressive", "full"], "default": "progressive", "description": "Lesson 覆盖树与知识路线树的首次展开量；高级可选覆盖，首启不主动询问。"},
    "branch_confirmation": {"type": "string", "default": "每支讲完确认", "description": "高级可选覆盖。"},
    "cycle_structure": {"type": "string", "default": "按课程与活动生成", "description": "高级可选覆盖。"},
    "small_adjustment": {"type": "string", "default": "每循环至多调整一处运行参数", "description": "高级可选覆盖。"},
    "big_adjustment": {"type": "string", "default": "每三个循环一次调整窗口", "description": "高级可选覆盖。"},
    "aged_review_mode": {"enum": ["off", "suggest", "auto"], "default": "suggest", "description": "高级可选覆盖。"},
    "exercise_hint_gate": {"enum": ["enabled", "disabled"], "default": "enabled", "description": "练习提示闸门默认启用，可稍后修改。"},
    "learning_timezone": {"type": "string", "default": "UTC", "description": "高级可选覆盖；IANA 时区名。"},
    "learning_day_cutoff": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "04:00", "description": "高级可选覆盖。"},
    "lesson_actual_review": {"enum": ["on", "off"], "default": "on"},
    "lesson_student_feedback": {"enum": ["on", "off"], "default": "on"},
    "lesson_knowledge_absorption": {"enum": ["on", "off"], "default": "on"},
    "exercise_problem_review": {"enum": ["on", "off"], "default": "on"},
    "exercise_knowledge_mastery": {"enum": ["on", "off"], "default": "on"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "高级可选覆盖；省略时使用宿主当前日期。"},
    "agent_pool_limit": {"type": "integer", "minimum": 1, "maximum": 6, "default": 6},
    "agent_max_active": {"type": "integer", "minimum": 1, "maximum": 3, "default": 3},
    "agent_parallel_startup": {"enum": ["enabled", "disabled"], "default": "enabled"},
    "agent_startup_readiness": {"type": "string", "default": "learning_ready_first"},
    "agent_background_reporting": {"type": "string", "default": "blockers_only"}
  },
  "required": [],
  "x-not-in-this-schema": {
    "teaching_language": "由安装阶段无默认语言选择决定；中文版初始 zh-CN，英文版初始 en-US。init 只保留版本模板中的该值。"
  }
}
